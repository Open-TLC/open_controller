// time units in seconds
"time_step":0.1,
"real_time_multiplier":1,

// Modes will be: sumo, test, realtime
"operation_mode":"test",

"sumo":{
    "graph" : true,
    "file_name": "../models/4legleft/4l_50m/4legleft_50m6dets.sumocfg",
    "print_status": true,
    "group_outputs": ["group5", "group0", "group0", "group1", "group2", "group3", "group3", "group4"]
//    "group_outputs": ["group0", "group1", "group2", "group3", "group4", "group5"]
},

// Controller operations
"controller":{
    "name": "test",
    "sumo_name": "N_J1",
    // Signal groups, controller object has a list value "groups"
    // defining which ones are used
    "signal_groups":{
        //Values used, id not specified later
        // request_type can be:
        //      "fixed" - always on
        //      "detector" - defined by detectors (see detectors section)
        // green_end can be:
        //      "after_ext" - green terminates after own extensions end
        //      "remain" - remains green until other extensions out
        "default":{
            "min_green": 5,
            "min_amber_red": 1,
            "min_red": 5,
            "min_amber": 3,
            "max_green": 1000,
            "max_amber_red": 1,
            "max_red": -1,
            "max_amber": 3,
            "request_type": "detector",
            "phase_request": false,
            "green_end": "remain"
            },

